  m_Script: {fileID: 11500000, guid: 1cf8192d04594a44e8a2468040f6b4b5, type: 3}
  m_Name: FishDialogue
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Fish
    dialogueText: Oh......Andy,you......on here.
  - speakerName: Andy
    dialogueText: Emmm....Why you know my name?
  - speakerName: Fish
    dialogueText: Good question,but who I am and why I know you name are a not so
      important issue.
  - speakerName: Fish
    dialogueText: Just like you don't know a fish can speak before,but still ask
      me question,right?
  - speakerName: Andy
    dialogueText: ......You are right.
  - speakerName: Fish
    dialogueText: But I am the one to lead you way as your thinking about.
  - speakerName: Andy
    dialogueText: What should I do?
  - speakerName: Fish
    dialogueText: You will know by your action.
  loadSceneAfterDialogue: 1
  sceneToLoad: SampleScene
