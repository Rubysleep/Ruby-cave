  m_Script: {fileID: 11500000, guid: 1cf8192d04594a44e8a2468040f6b4b5, type: 3}
  m_Name: Prologue
  m_EditorClassIdentifier: 
  lines:
  - speakerName: Andy
    dialogueText: Ahh......Where am I?Why I am here?
  - speakerName: Andy
    dialogueText: Not important,what I can do now is to try my best and get out this
      place.
  - speakerName: Andy
    dialogueText: Emmm.....I think there is a fish over there?On the land?
  - speakerName: Andy
    dialogueText: Never mind,what important is to get out.
  - speakerName: Andy
    dialogueText: Let's ask it something.
